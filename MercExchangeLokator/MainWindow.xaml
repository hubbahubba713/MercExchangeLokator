<Window x:Class="MercExchangeLokator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MercExchangeLokator"
        mc:Ignorable="d"
        Title="Merc Exchange Lokator v0.1" Width="800" WindowStyle="ToolWindow" Closing="Window_Closing" Loaded="Window_Loaded" Unloaded="Window_Unloaded" SizeToContent="Height">
    <Grid>
        <DockPanel LastChildFill="True">
            <ToolBarPanel Height="24" VerticalAlignment="Top">
                <ToolBar Height="24">
                    <Image Source="Images/captureIcon01.png" Height="16" Width="16" x:Name="StartCaptureBtn" Margin="5,0" ToolTip="Start Screen Capturing" IsEnabled="True" MouseDown="StartCaptureBtn_MouseDown">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <Image Source="Images/stopCaptureIcon01.png" Height="16" Width="16" x:Name="StopCaptureBtn" Margin="5,0" ToolTip="Stop Screen Capturing" IsEnabled="False" MouseDown="StopCaptureBtn_MouseDown">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>

                    </Image>
                    <Image Source="Images/SettingsIcon01.png" Height="16" Width="16" x:Name="SettingsBtn" Margin="5,0" ToolTip="Settings" MouseDown="SettingsBtn_MouseDown"/>
                    <Separator/>
                    <TextBlock x:Name="ThresholdLabel" VerticalAlignment="Center" Margin="6,0,4,0" Text="Threshold"/>
                    <Slider x:Name="ThresholdSlider"
                            Width="130"
                            Minimum="0.30"
                            Maximum="0.55"
                            SmallChange="0.01"
                            LargeChange="0.02"
                            TickFrequency="0.01"
                            IsSnapToTickEnabled="True"
                            Value="0.40"
                            ValueChanged="ThresholdSlider_ValueChanged"/>
                    <TextBlock x:Name="ThresholdValueText" VerticalAlignment="Center" Margin="4,0,6,0" Text="0.40"/>
                        <Button x:Name="ThresholdResetButton" Height="20" Margin="0,0,4,0" Padding="6,0" Content="Reset" Click="ThresholdResetButton_Click" ToolBar.OverflowMode="Never"/>
                        <Separator/>
                        <TextBlock x:Name="TopBandLabel" VerticalAlignment="Center" Margin="4,0,2,0" Text="Top" ToolBar.OverflowMode="Always"/>
                        <Slider x:Name="TopBandSlider"
                            Width="90"
                            Minimum="0.00"
                            Maximum="0.80"
                            SmallChange="0.01"
                            LargeChange="0.02"
                            TickFrequency="0.01"
                            IsSnapToTickEnabled="True"
                            Value="0.12"
                                ValueChanged="TopBandSlider_ValueChanged"
                                ToolBar.OverflowMode="Always"/>
                            <TextBlock x:Name="TopBandValueText" VerticalAlignment="Center" Margin="3,0,5,0" Text="12%" ToolBar.OverflowMode="Always"/>
                            <TextBlock x:Name="BottomBandLabel" VerticalAlignment="Center" Margin="2,0,2,0" Text="Bottom" ToolBar.OverflowMode="Always"/>
                        <Slider x:Name="BottomBandSlider"
                            Width="90"
                            Minimum="0.20"
                            Maximum="1.00"
                            SmallChange="0.01"
                            LargeChange="0.02"
                            TickFrequency="0.01"
                            IsSnapToTickEnabled="True"
                            Value="0.90"
                            ValueChanged="BottomBandSlider_ValueChanged"
                            ToolBar.OverflowMode="Always"/>
                    <TextBlock x:Name="BottomBandValueText" VerticalAlignment="Center" Margin="3,0,4,0" Text="90%" ToolBar.OverflowMode="Always"/>
                    <Button x:Name="ZoneResetButton" Height="20" Margin="0,0,4,0" Padding="6,0" Content="Zone Reset" Click="ZoneResetButton_Click" ToolBar.OverflowMode="Always"/>
                </ToolBar>
            </ToolBarPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,6,2">
                <Button x:Name="ThresholdResetAlwaysVisibleButton" Height="20" MinWidth="64" Padding="8,0" Content="Reset" Click="ThresholdResetButton_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
